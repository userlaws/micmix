{
  "name": "micmix",
  "version": "0.0.0",
  "private": true,
  "description": "Windows virtual microphone mixer",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "check:devices": "npm run build && node scripts/start.mjs --diagnose",
    "check:phase2": "npm run build && node scripts/check-phase2.mjs",
    "check:phase3": "npm run build && node scripts/start.mjs --smoke-phase3",
    "check:phase4": "npm run build && node scripts/start.mjs --smoke-phase4",
    "check:capture": "npm run build && node scripts/run-capture-probe.mjs",
    "check:youtube": "npm run build && node scripts/run-capture-probe.mjs --youtube"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
